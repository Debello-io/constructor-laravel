{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "enabledMcpjsonServers": [
        "constructor-docs"
    ],
    "permissions": {
        "allow": [
            "Bash(composer validate:*)",
            "Bash(vendor/bin/pint:*)",
            "Bash(php -l:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "mcp__constructor-docs"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./.env.*.local)",
            "Read(./.env.prod*)",
            "Read(./.env.staging*)",
            "Read(./.env.stage*)",
            "Read(./.env.dev*)",
            "Read(./.env.test*)",
            "Read(./.env.backup*)",
            "Read(./.env.bak*)",
            "Read(./**/.env)",
            "Read(./.env.live)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-php.sh",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
