# =============================================================================
# Constructor for Laravel
# Every setting is explained in config/constructor.php.
# =============================================================================

# --- Credentials -------------------------------------------------------------
# Three different credentials. Do not reuse one for another.
#
# API key (public). Dashboard: Integration > API Integration.
CONSTRUCTOR_API_KEY=key_your-api-key
#
# API token (secret). Only for catalog management (uploads, items, tasks).
CONSTRUCTOR_API_TOKEN=
#
# Backend security token (secret), sent as the x-cnstrc-token header on
# search/browse/autocomplete/recommendation/agent requests. Ask your
# Constructor contact for it. Without it, server traffic may be throttled.
CONSTRUCTOR_BACKEND_TOKEN=

# --- Integration identity ----------------------------------------------------
# `c` parameter. Format: cio-be-web-{company}. Empty = cio-be-web-{APP_NAME slug}.
CONSTRUCTOR_CLIENT_IDENTIFIER=

# Index section used when a call doesn't specify one.
CONSTRUCTOR_SECTION=Products

# Generate the beacon's client ID cookie on a shopper's first visit.
CONSTRUCTOR_GENERATE_CLIENT_ID=true

# Send auth()->id() as `ui` for signed-in shoppers.
CONSTRUCTOR_SEND_USER_ID=true

# --- AI agents ---------------------------------------------------------------
# Required for the AI Shopping Agent.
CONSTRUCTOR_AGENT_DOMAIN=
CONSTRUCTOR_AGENT_GUARD=true
CONSTRUCTOR_AGENT_NUM_RESULT_EVENTS=5
CONSTRUCTOR_AGENT_NUM_RESULTS_PER_EVENT=4

# --- HTTP client -------------------------------------------------------------
CONSTRUCTOR_TIMEOUT=10
CONSTRUCTOR_STREAM_TIMEOUT=120
# Total attempts. Only connection errors, 429 and 5xx are retried.
CONSTRUCTOR_RETRY_ATTEMPTS=2
# Milliseconds before the first retry; doubles each time.
CONSTRUCTOR_RETRY_DELAY=100

# --- Errors & logging --------------------------------------------------------
# false: storefront reads log and return empty results. true: throw.
CONSTRUCTOR_THROW_EXCEPTIONS=false
CONSTRUCTOR_LOG_CHANNEL=

# --- Catalog management ------------------------------------------------------
CONSTRUCTOR_NOTIFICATION_EMAIL=
CONSTRUCTOR_FORCE_UPLOAD=false
CONSTRUCTOR_UPLOAD_TIMEOUT=300
CONSTRUCTOR_TASK_POLL_INTERVAL=10
CONSTRUCTOR_TASK_TIMEOUT=600

# --- Laravel Scout -----------------------------------------------------------
# SCOUT_DRIVER=constructor
CONSTRUCTOR_SCOUT_BATCH_SIZE=1000

# --- Hosts (only change if Constructor tells you to) -------------------------
CONSTRUCTOR_SEARCH_BASE_URL=https://ac.cnstrc.com
CONSTRUCTOR_AGENT_BASE_URL=https://agent.cnstrc.com
