{
    "name": "debello-io/constructor-laravel",
    "description": "Laravel integration for Constructor - AI-powered search, browse, autocomplete, recommendations, shopping agents and catalog management",
    "keywords": ["laravel", "constructor", "constructor.io", "search", "ecommerce", "recommendations", "ai", "autocomplete", "product-discovery", "scout"],
    "license": "MIT",
    "authors": [
        {
            "name": "Timothy John Bancroft"
        }
    ],
    "homepage": "https://github.com/Debello-io/constructor-laravel",
    "support": {
        "issues": "https://github.com/Debello-io/constructor-laravel/issues",
        "source": "https://github.com/Debello-io/constructor-laravel"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/scout": "^11.0",
        "orchestra/testbench": "^9.2|^10.0|^11.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "laravel/scout": "Required to use the 'constructor' Scout engine (^11.0)"
    },
    "autoload": {
        "psr-4": {
            "ConstructorIO\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ConstructorIO\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ConstructorIO\\Laravel\\ConstructorServiceProvider"
            ],
            "aliases": {
                "Constructor": "ConstructorIO\\Laravel\\Facades\\Constructor"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
