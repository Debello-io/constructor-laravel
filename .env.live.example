# Credentials for `composer test:live`, the smoke tests against a real
# Constructor index. Copy to .env.live (git-ignored) and fill in.
# Use a TEST index: never production credentials.

# --- Required ---------------------------------------------------------------
CONSTRUCTOR_API_KEY=
CONSTRUCTOR_BACKEND_TOKEN=

# --- Optional: each one enables more checks ---------------------------------
# Catalog reads (verify credentials, list items).
CONSTRUCTOR_API_TOKEN=
# AI Shopping Agent and Product Insights Agent.
CONSTRUCTOR_AGENT_DOMAIN=
CONSTRUCTOR_SECTION=Products

# A search term that returns results in your index.
CONSTRUCTOR_LIVE_QUERY=grill
# An item ID from your catalog (product page pods, product questions, getItem).
CONSTRUCTOR_LIVE_ITEM_ID=
# A recommendation pod ID, and a page ID if page recommendations are enabled.
CONSTRUCTOR_LIVE_POD_ID=
CONSTRUCTOR_LIVE_PAGE_ID=
# A quiz ID, if quizzes are enabled.
CONSTRUCTOR_LIVE_QUIZ_ID=

# Writes: upsert and then delete one item, "cio-laravel-smoke-test", in this
# section. Only on a test index. Both lines are required to enable writes.
CONSTRUCTOR_LIVE_ALLOW_WRITES=false
CONSTRUCTOR_LIVE_WRITE_SECTION=
